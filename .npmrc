# Do not run dependencies' install scripts.
#
# better-sqlite3 ships prebuilt binaries for Linux, macOS and Windows (x64 and
# arm64, glibc and musl) and loads them first. But because the package also
# contains a binding.gyp, npm runs `node-gyp rebuild` on install anyway — which
# needs Python and a C++ toolchain, and fails outright on hosts without them
# (Hostinger's build environment among them). The compiled result would never
# be used.
#
# The only other install scripts in the tree are esbuild's binary check, which
# its platform package makes unnecessary, and fsevents (macOS, optional).
#
# `npm run …`, `npm start` and `npm test` still run their own scripts.
ignore-scripts=true
